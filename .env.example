# 기본 카탈로그: TCGdex 한국어 API. 다른 언어 API를 사용하려면 API base 경로를 변경하세요.
TCGDEX_API_BASE=https://api.tcgdex.net/v2/ko
TCGDEX_EN_API_BASE=https://api.tcgdex.net/v2/en
TCGDEX_JA_API_BASE=https://api.tcgdex.net/v2/ja
PORT=3000
CACHE_TTL_SECONDS=900

# 선택 사항: 직접 계약/운영하는 가격 공급자 bulk API 주소.
# 서버에서만 호출되며 브라우저 코드에는 API 키를 노출하지 않습니다.
PRICE_API_URL=
PRICE_API_KEY=
